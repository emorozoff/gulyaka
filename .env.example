# Supabase
# Project URL — публичный, попадает в браузерный бандл
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (бывший anon key) — публичный, безопасен для клиента
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Service Role / Secret key — SECRET, только на сервере, НЕ коммитить
# Нужен для pnpm content:import (обход RLS при загрузке POI в Supabase).
# Берётся в Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Anthropic API
# Нужен для pnpm content:write (написание живых текстов через Claude).
# Берётся в console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-xxx
